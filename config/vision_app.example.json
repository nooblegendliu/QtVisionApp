{
  "schemaVersion": 1,
  "tcp": {
    "listenAddress": "0.0.0.0",
    "port": 9000,
    "heartbeatTimeoutMs": 3000,
    "maximumFrameBytes": 16384
  },
  "vision": {
    "captureTimeoutMs": 1000,
    "algorithmConfigPath": "../VisionAlgorithm/config/vision_algorithm.example.yaml",
    "productionTrigger": {
      "inputLine": "LINE0",
      "activation": "RISING_EDGE",
      "delayUs": 0.0
    },
    "cameras": [
      {
        "role": "CENTER",
        "model": "MV_CH250_90GM",
        "serialNumber": "REPLACE_CENTER_SERIAL",
        "exposureUs": 10000.0,
        "gain": 0.0
      },
      {
        "role": "TOP_LEFT",
        "model": "MV_CS120_10GM",
        "serialNumber": "REPLACE_TOP_LEFT_SERIAL",
        "exposureUs": 10000.0,
        "gain": 0.0
      },
      {
        "role": "TOP_RIGHT",
        "model": "MV_CS120_10GM",
        "serialNumber": "REPLACE_TOP_RIGHT_SERIAL",
        "exposureUs": 10000.0,
        "gain": 0.0
      },
      {
        "role": "BOTTOM_RIGHT",
        "model": "MV_CS120_10GM",
        "serialNumber": "REPLACE_BOTTOM_RIGHT_SERIAL",
        "exposureUs": 10000.0,
        "gain": 0.0
      },
      {
        "role": "BOTTOM_LEFT",
        "model": "MV_CS120_10GM",
        "serialNumber": "REPLACE_BOTTOM_LEFT_SERIAL",
        "exposureUs": 10000.0,
        "gain": 0.0
      }
    ],
    "lightController": {
      "serialNumber": "REPLACE_LIGHT_CONTROLLER_SERIAL",
      "channels": [
        {
          "role": "WHITE_BACKLIGHT",
          "outputSelector": "REPLACE_WHITE_OUTPUT",
          "normalizedIntensity": 0.5
        },
        {
          "role": "COAXIAL_RED",
          "outputSelector": "REPLACE_RED_OUTPUT",
          "normalizedIntensity": 0.5
        },
        {
          "role": "COAXIAL_GREEN",
          "outputSelector": "REPLACE_GREEN_OUTPUT",
          "normalizedIntensity": 0.5
        },
        {
          "role": "COAXIAL_BLUE",
          "outputSelector": "REPLACE_BLUE_OUTPUT",
          "normalizedIntensity": 0.5
        }
      ]
    }
  },
  "resultDelivery": {
    "acknowledgementIntervalMs": 1000,
    "maximumRetries": 3
  },
  "logging": {
    "directory": "../logs",
    "level": "info",
    "maximumFileMiB": 10,
    "maximumFiles": 10
  }
}
