<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros">
    <HikSdkRoot Condition="'$(HikSdkRoot)'==''">$(MVCAM_COMMON_RUNENV)</HikSdkRoot>
  </PropertyGroup>
  <PropertyGroup>
    <IncludePath>$(HikSdkRoot)\Includes;$(IncludePath)</IncludePath>
    <LibraryPath>$(HikSdkRoot)\Libraries\win64;$(LibraryPath)</LibraryPath>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <Link>
      <AdditionalDependencies>MvCameraControl.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup />
</Project>
